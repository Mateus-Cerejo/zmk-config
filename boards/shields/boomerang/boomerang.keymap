#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define LC LCTRL
#define LS LSHIFT
#define LA LALT
#define ENT ENTER
#define BS BACKSPACE
#define SP SPACE

/ {
    keymap {
	compatible = "zmk,keymap";

	default_layer { // Layer 0
	    bindings = <
	&kp Q   &kp W   &kp E   &kp R
&kp LC	&kp A   &kp S   &kp D   &kp F   &kp G
	&kp Z   &kp X   &kp C   &kp V
				&kp LS	&kp SP	&kp LA
						&kp BS
						&kp ENT
	    >;
	};
    };
 };