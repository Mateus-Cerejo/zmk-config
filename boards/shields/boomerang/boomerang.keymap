#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ENT ENTER
#define BS BACKSPACE
#define SP SPACE

/ {
    keymap {
		compatible = "zmk,keymap";

		default_layer { // Layer 0
			bindings = <
				&kp Q   &kp W   &kp F   &kp P												&kp L   &kp U   &kp Y   &kp J
	&kp LCTRL	&kp A   &kp R   &kp S   &kp T   	&kp D							&kp H	&kp N   &kp E   &kp I   &kp O   &kp RSHIFT
				&kp Z   &kp X   &kp C   &kp V												&kp M   &kp G   &kp B   &kp K
										&kp LSHIFT	&kp SP	&kp LALT	&kp RSHIFT	&kp SP	&kp RALT
															&kp BS		&kp BS
															&kp ENT		&kp ENT
			>;
		};
    };
 };