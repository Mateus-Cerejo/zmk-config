#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ENT ENTER
#define BS BACKSPACE
#define SP SPACE

/ {
    keymap {
		compatible = "zmk,keymap";

		default_layer { // Layer 0
			bindings = <
				&kp Q   &kp W   &kp E   &kp R												&kp U   &kp I   &kp O   	&kp P
	&kp LCTRL	&kp A   &kp S   &kp D   &kp F   	&kp G							&kp H	&kp J   &kp K   &kp L   	&kp SEMI   &kp RCTRL
				&kp Z   &kp X   &kp C   &kp V												&kp N   &kp M   &kp COMMA   &kp DOT
										&kp LSHIFT	&kp SP	&kp LALT	&kp RSHIFT	&kp SP	&kp RALT
															&kp BS		&kp BS
															&kp ENT		&kp ENT
			>;
		};
    };
 };